# ========================================================
# Smart Bus Bengal - Local Environment Variables Template
# Copy this file to .env and fill in your actual values:
#   cp .env.example .env
# ========================================================

# Server Port
PORT=8080

# Neon PostgreSQL 18 Connection
# Replace with your Neon connection credentials (SSL is required for Neon)
# e.g., postgresql://username:password@ep-xyz.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
DB_HOST=ep-your-subdomain.ap-southeast-1.aws.neon.tech
DB_PORT=5432
DB_NAME=neondb
DB_USERNAME=your_neon_username
DB_PASSWORD=your_neon_password
DB_SSL_MODE=require

# Redis Connection (Upstash for Cloud or localhost for Docker)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_SSL=false

# Spring Security & JWT
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000

# AI Configuration (Sprint 3)
GEMINI_API_KEY=your_gemini_api_key_here

